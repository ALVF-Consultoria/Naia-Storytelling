# Configurações do Servidor
PORT=3000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Configurações do Banco de Dados (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_aqui
DB_NAME=naia_storytell

# Autenticação (JWT)
JWT_SECRET=sua_chave_secreta_super_segura_aqui

# Integração com Inteligência Artificial (Google Gemini)
# Crie sua chave em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua_chave_gemini_aqui
STORY_MODEL=gemini-2.5-flash

# Geração de Imagens (Opcional)
ENABLE_IMAGE_GENERATION=false
IMAGE_MODEL=google/gemini-2.5-flash-image
